<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yabushan.datasource.mapper.MetadataDatasourceTypeParamMapper">
    
    <resultMap type="MetadataDatasourceTypeParam" id="MetadataDatasourceTypeParamResult">
        <result property="paramId"    column="PARAM_ID"    />
        <result property="dbTypeId"    column="DB_TYPE_ID"    />
        <result property="paramCode"    column="PARAM_CODE"    />
        <result property="paramValue"    column="PARAM_VALUE"    />
        <result property="paramDesc"    column="PARAM_DESC"    />
    </resultMap>

    <sql id="selectMetadataDatasourceTypeParamVo">
        select PARAM_ID, DB_TYPE_ID, PARAM_CODE, PARAM_VALUE, PARAM_DESC from metadata_datasource_type_param
    </sql>

    <select id="selectMetadataDatasourceTypeParamList" parameterType="MetadataDatasourceTypeParam" resultMap="MetadataDatasourceTypeParamResult">
        <include refid="selectMetadataDatasourceTypeParamVo"/>
        <where>  
            <if test="dbTypeId != null  and dbTypeId != ''"> and DB_TYPE_ID = #{dbTypeId}</if>
            <if test="paramCode != null  and paramCode != ''"> and PARAM_CODE = #{paramCode}</if>
            <if test="paramValue != null  and paramValue != ''"> and PARAM_VALUE = #{paramValue}</if>
            <if test="paramDesc != null  and paramDesc != ''"> and PARAM_DESC = #{paramDesc}</if>
        </where>
    </select>
    
    <select id="selectMetadataDatasourceTypeParamById" parameterType="String" resultMap="MetadataDatasourceTypeParamResult">
        <include refid="selectMetadataDatasourceTypeParamVo"/>
        where PARAM_ID = #{paramId}
    </select>
        
    <insert id="insertMetadataDatasourceTypeParam" parameterType="MetadataDatasourceTypeParam">
        insert into metadata_datasource_type_param
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="paramId != null">PARAM_ID,</if>
            <if test="dbTypeId != null and dbTypeId != ''">DB_TYPE_ID,</if>
            <if test="paramCode != null and paramCode != ''">PARAM_CODE,</if>
            <if test="paramValue != null">PARAM_VALUE,</if>
            <if test="paramDesc != null">PARAM_DESC,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="paramId != null">#{paramId},</if>
            <if test="dbTypeId != null and dbTypeId != ''">#{dbTypeId},</if>
            <if test="paramCode != null and paramCode != ''">#{paramCode},</if>
            <if test="paramValue != null">#{paramValue},</if>
            <if test="paramDesc != null">#{paramDesc},</if>
         </trim>
    </insert>

    <insert id="bathInsertMetadataDatasourceTypeParam" parameterType="java.util.List">
        insert into metadata_datasource_type_param
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                PARAM_ID,
                                                                DB_TYPE_ID,
                                                                PARAM_CODE,
                                                                PARAM_VALUE,
                                                                PARAM_DESC,
                                    </trim>
        values
        <foreach collection ="list" item="item" separator =",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                                                            #{item.paramId},
                                                                                #{item.dbTypeId},
                                                                                #{item.paramCode},
                                                                                #{item.paramValue},
                                                                                #{item.paramDesc},
                                                </trim>
       </foreach>
    </insert>

    <update id="updateMetadataDatasourceTypeParam" parameterType="MetadataDatasourceTypeParam">
        update metadata_datasource_type_param
        <trim prefix="SET" suffixOverrides=",">
            <if test="dbTypeId != null and dbTypeId != ''">DB_TYPE_ID = #{dbTypeId},</if>
            <if test="paramCode != null and paramCode != ''">PARAM_CODE = #{paramCode},</if>
            <if test="paramValue != null">PARAM_VALUE = #{paramValue},</if>
            <if test="paramDesc != null">PARAM_DESC = #{paramDesc},</if>
        </trim>
        where PARAM_ID = #{paramId}
    </update>

    <delete id="deleteMetadataDatasourceTypeParamById" parameterType="String">
        delete from metadata_datasource_type_param where PARAM_ID = #{paramId}
    </delete>

    <delete id="deleteMetadataDatasourceTypeParamByIds" parameterType="String">
        delete from metadata_datasource_type_param where PARAM_ID in 
        <foreach item="paramId" collection="array" open="(" separator="," close=")">
            #{paramId}
        </foreach>
    </delete>
    
</mapper>