    </update>

    <delete id="deleteLowBusinessListById" parameterType="String">
        delete from low_business_list where LIST_ID = #{listId}
    </delete>

    <delete id="deleteLowBusinessListByIds" parameterType="String">
        delete from low_business_list where LIST_ID in
        <foreach item="listId" collection="array" open="(" separator="," close=")">
            #{listId}
        </foreach>
    </delete>

</mapper>
