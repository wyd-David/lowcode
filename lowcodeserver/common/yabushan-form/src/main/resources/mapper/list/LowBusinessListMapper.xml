<mapper namespace="com.yabushan.form.mapper.LowBusinessListMapper">

    <resultMap type="LowBusinessList" id="LowBusinessListResult">
        <result property="listId"    column="LIST_ID"    />
        <result property="listName"    column="LIST_NAME"    />
        <result property="listCode"    column="LIST_CODE"    />
        <result property="needQeuryBtn"    column="NEED_QEURY_BTN"    />
        <result property="needExportBtn"    column="NEED_EXPORT_BTN"    />
        <result property="needInportBtn"    column="NEED_INPORT_BTN"    />
        <result property="needUpdateBtn"    column="NEED_UPDATE_BTN"    />
        <result property="needDeleteBtn"    column="NEED_DELETE_BTN"    />
        <result property="needViewBtn"    column="NEED_VIEW_BTN"    />
        <result property="listFlowProcdefId"    column="LIST_FLOW_PROCDEF_ID"    />
        <result property="formUuid"    column="FORM_UUID"    />
        <result property="listStatus"    column="LIST_STATUS"    />
        <result property="listMemo"    column="LIST_MEMO"    />
        <result property="dataResourceid"    column="DATA_RESOURCEID"    />
        <result property="dataApi"    column="DATA_API"    />
        <result property="createdBy"    column="CREATED_BY"    />
