            <if test="listCode != null">LIST_CODE = #{listCode},</if>
            <if test="needQeuryBtn != null">NEED_QEURY_BTN = #{needQeuryBtn},</if>
            <if test="needExportBtn != null">NEED_EXPORT_BTN = #{needExportBtn},</if>
            <if test="needInportBtn != null">NEED_INPORT_BTN = #{needInportBtn},</if>
            <if test="needUpdateBtn != null">NEED_UPDATE_BTN = #{needUpdateBtn},</if>
            <if test="needDeleteBtn != null">NEED_DELETE_BTN = #{needDeleteBtn},</if>
            <if test="needViewBtn != null">NEED_VIEW_BTN = #{needViewBtn},</if>
            <if test="listFlowProcdefId != null">LIST_FLOW_PROCDEF_ID = #{listFlowProcdefId},</if>
            <if test="formUuid != null">FORM_UUID = #{formUuid},</if>
            <if test="listStatus != null">LIST_STATUS = #{listStatus},</if>
            <if test="listMemo != null">LIST_MEMO = #{listMemo},</if>
            <if test="listMemoChild != null">LIST_MEMO_CHILD = #{listMemoChild},</if>
