            <if test="createdTime != null">#{createdTime},</if>
            <if test="updatedBy != null">#{updatedBy},</if>
            <if test="updatedTime != null">#{updatedTime},</if>
            <if test="tenantId != null">#{tenantId},</if>
         </trim>
    </insert>

    <insert id="bathInsertLowBusinessList" parameterType="java.util.List">
        insert into low_business_list
        <trim prefix="(" suffix=")" suffixOverrides=",">
                                                LIST_ID,
                                                                LIST_NAME,
                                                                LIST_CODE,
                                                                NEED_QEURY_BTN,
                                                                NEED_EXPORT_BTN,
                                                                NEED_INPORT_BTN,
                                                                NEED_UPDATE_BTN,
                                                                NEED_DELETE_BTN,
                                                                NEED_VIEW_BTN,
                                                                LIST_FLOW_PROCDEF_ID,
                                                                FORM_UUID,
                                                                LIST_STATUS,
                                                                LIST_MEMO,
                                                                LIST_MEMO_CHILD,
                                                                DATA_RESOURCEID,
                                                                DATA_API,
                                                                CREATED_BY,
                                                                CREATED_TIME,
                                                                UPDATED_BY,
                                                                UPDATED_TIME,
                                                                TENANT_ID,
                                    </trim>
        values
        <foreach collection ="list" item="item" separator =",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
