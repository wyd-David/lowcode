            <if test="updatedTime != null">updated_time = #{updatedTime},</if>
            <if test="updatedByName != null and updatedByName != ''">updated_By_Name = #{updatedByName},</if>
            <if test="delFlag != null">del_flag = #{delFlag},</if>
        </trim>
