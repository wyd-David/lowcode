            <if test="updatedBy != null">#{updatedBy},</if>
            <if test="updatedTime != null">#{updatedTime},</if>
            <if test="updatedByName != null and updatedByName != ''">#{updatedByName},</if>
            <if test="delFlag != null">#{delFlag},</if>
        </trim>
    </insert>

    <insert id="bathInsertActXunchaProcinst" parameterType="java.util.List">
        insert into act_xuncha_procinst
        <trim prefix="(" suffix=")" suffixOverrides=",">
            procinst_id,
            business_key,
            business_type,
            business_type_name,
            business_name,
            status,
            created_by,
            created_time,
            created_by_name,
            updated_by,
            updated_time,
            updated_by_name,
            del_flag,
        </trim>
        values
        <foreach collection="list" item="item" separator=",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{item.procinstId},
                #{item.businessKey},
                #{item.businessType},
                #{item.businessTypeName},
                #{item.businessName},
                #{item.status},
                #{item.createdBy},
                #{item.createdTime},
                #{item.createdByName},
                #{item.updatedBy},
                #{item.updatedTime},
                #{item.updatedByName},
                #{item.delFlag},
            </trim>
        </foreach>
    </insert>

    <update id="updateActXunchaProcinst" parameterType="ActXunchaProcinst">
        update act_xuncha_procinst
        <trim prefix="SET" suffixOverrides=",">
            <if test="businessKey != null and businessKey != ''">business_key = #{businessKey},</if>
            <if test="businessType != null">business_type = #{businessType},</if>
            <if test="businessTypeName != null">business_Type_Name = #{businessTypeName},</if>
            <if test="businessName != null">business_name = #{businessName},</if>
