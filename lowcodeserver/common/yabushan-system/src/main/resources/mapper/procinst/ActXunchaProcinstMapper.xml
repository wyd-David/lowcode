    <sql id="selectActXunchaProcinstVo">
        select procinst_id, business_key, business_type,business_type_name, business_name, status, created_by, created_time,created_by_name, updated_by, updated_time,updated_by_name ,del_flag from act_xuncha_procinst
    </sql>

    <select id="selectActXunchaProcinstList" parameterType="ActXunchaProcinst" resultMap="ActXunchaProcinstResult">
        <include refid="selectActXunchaProcinstVo"/>
        <where>
            <if test="businessKey != null  and businessKey != ''">and business_key = #{businessKey}</if>
            <if test="businessType != null  and businessType != ''">and business_type = #{businessType}</if>
            <if test="businessName != null  and businessName != ''">and business_name like concat('%', #{businessName},
                '%')
            </if>
            <if test="status != null  and status != ''">and status = #{status}</if>
            <if test="createdBy != null  and createdBy != ''">and created_by = #{createdBy}</if>
            <if test="createdTime != null ">and created_time = #{createdTime}</if>
            <if test="createdByName != null and createdByName !=''">and created_by_name like concat('%',
                #{createdByName},'%')
            </if>
            <if test="updatedBy != null  and updatedBy != ''">and updated_by = #{updatedBy}</if>
            <if test="updatedTime != null ">and updated_time = #{updatedTime}</if>
            <if test="updatedByName != null and updatedByName != ''">and updated_by_name like concat('%',
                #{updatedByName},'%')
            </if>
            <if test="delFlag != null">and del_flag = #{delFlag}</if>
        </where>
        order by created_time desc
    </select>

    <select id="selectActXunchaProcinstById" parameterType="String" resultMap="ActXunchaProcinstResult">
        <include refid="selectActXunchaProcinstVo"/>
        where procinst_id = #{procinstId}
    </select>

    <insert id="insertActXunchaProcinst" parameterType="ActXunchaProcinst">
