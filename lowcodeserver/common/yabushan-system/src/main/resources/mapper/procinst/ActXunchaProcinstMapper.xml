        delete from  where procinst_id = #{procinstId}
    </delete>
    <delete id="deleteActXunchaProcinstByBusinessKey" parameterType="String">
        update act_xuncha_procinst set del_flag=1 where  business_key = #{businessKey}
    </delete>

    <delete id="deleteActXunchaProcinstByIds" parameterType="Long">
        delete from act_xuncha_procinst where procinst_id in
        <foreach item="procinstId" collection="array" open="(" separator="," close=")">
            #{procinstId}
        </foreach>
    </delete>

    <resultMap type="ActXunchaProcinstVO" id="ActXunchaProcinstMap">
        <result property="procinstId" column="procinst_id"/>
        <result property="businessKey" column="business_key"/>
        <result property="businessType" column="business_type"/>
        <result property="businessTypeName" column="business_type_name"/>
        <result property="businessName" column="business_name"/>
        <result property="createdBy" column="created_by"/>
        <result property="createdTime" column="created_time"/>
        <result property="status" column="todo_tp_link"/>
        <result property="todoType" column="todo_type"/>
        <result property="todoHandlerName" column="todo_handler_name"/>
        <result property="todoUrl" column="todo_url"/>
        <result property="lastUpdateTime" column="lastUpdateTime"/>
        <result property="countNum" column="countNum"/>
    </resultMap>

    <select id="myWorkList" parameterType="ActXunchaProcinst" resultMap="ActXunchaProcinstMap">
        SELECT
            axp.procinst_id,
            axp.business_key,
            axp.business_type,
            axp.business_type_name,
            axp.business_name,
            axp.created_time,
            axp.created_by,
            ti.todo_tp_link,
            ti.todo_handler_name,
            ti.todo_type,
            ti.todo_url,
            ti.create_time lastUpdateTime,
            t2.countNum
        FROM
            act_xuncha_procinst axp
        LEFT JOIN (
            SELECT
                todo_tp_link
                ,todo_handler_name
                ,create_time,
                business_key,
                todo_url,
                todo_type,
                todo_handler
            FROM todo_info WHERE task_type=1) ti ON axp.business_key = ti.business_key
        LEFT JOIN (SELECT COUNT(todo_id) countNum,business_key FROM todo_info WHERE task_type=1 GROUP BY business_key) t2
        ON t2.business_key=ti.business_key
        WHERE
            axp.del_flag = 0
        <if test="businessKey != null  and businessKey != ''">and axp.business_key like concat('%', #{businessKey},'%')</if>
        <if test="businessType != null  and businessType != ''">and axp.business_type like concat('%', #{businessType},'%')</if>
        <if test="businessName != null  and businessName != ''">and axp.business_name like concat('%', #{businessName},'%')</if>
        <if test="status != null  and status != ''">and ti.todo_type = #{status}</if>
        <if test="createdBy != null  and createdBy != ''">and axp.created_by = #{createdBy}</if>
        <if test="params.beginTime != null">
            and axp.created_time &gt;= #{params.beginTime}
        </if>
        <if test="params.endTime != null">
            and axp.created_time &lt;= #{params.endTime}
        </if>
        ORDER BY
            axp.created_time DESC
    </select>
</mapper>
