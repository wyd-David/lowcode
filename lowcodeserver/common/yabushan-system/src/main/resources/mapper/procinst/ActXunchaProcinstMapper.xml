            <if test="businessKey != null and businessKey != ''">business_key,</if>
            <if test="businessType != null">business_type,</if>
            <if test="businessTypeName != null">business_type_name,</if>
            <if test="businessName != null">business_name,</if>
            <if test="status != null">status,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="createdByName != null and createdByName != ''">created_by_name,</if>
            <if test="updatedBy != null">updated_by,</if>
            <if test="updatedTime != null">updated_time,</if>
            <if test="updatedByName != null and updatedByName != ''">updated_by_name,</if>
            <if test="delFlag != null">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="procinstId != null">#{procinstId},</if>
            <if test="businessKey != null and businessKey != ''">#{businessKey},</if>
            <if test="businessType != null">#{businessType},</if>
            <if test="businessTypeName != null">#{businessTypeName},</if>
