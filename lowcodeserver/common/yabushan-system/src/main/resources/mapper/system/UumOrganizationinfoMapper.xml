    <select id="selectCompanyinfoList" parameterType="java.util.Map" resultMap="UumOrganizationinfoResult">
        select COMPANY,COMPANYID from uum_organizationinfo
        <where>
            COMPANYID IN(
                SELECT u.COMPANYID  FROM xuncha_talent_person_info p
                LEFT JOIN uum_userinfo u ON p.USER_ID = u.USERID
                left join sys_dict_data xdd on p.FIELD_TYPE = xdd.dict_value
                where xdd.dict_type = 'field_type'
                and xdd.dict_label = #{fieldKey}
                AND USER_ID IN (
                    SELECT USER_ID  FROM xuncha_talent_label_result
                    WHERE LABEL_ID = #{labelKey}
                )
            )
            <if test="company != null  and company != ''"> and COMPANY like concat('%', #{company}, '%')</if>
            <if test="companyids != null  and companyids != ''"> and COMPANYID NOT IN
                <foreach item="key" collection="companyids.split(',')" open="(" separator="," close=")">
                    #{key}
                </foreach>
            </if>
        </where>
        group by COMPANY,COMPANYID
        order by RAND()
    </select>

    <select id="getYjxtUumOrgInfo" parameterType="java.util.Map" resultMap="UumOrganizationinfoResult">
        SELECT * FROM yj_xt.uum_organizationinfo f
            WHERE f.LASTMODIFYTIME>(SELECT MAX(ff.LASTMODIFYTIME) FROM uum_organizationinfo ff)

    </select>

    <select id="getCompanyInfo" resultType="java.util.Map">
        select COMPANY_NAME companyName,COMPANY_ID companyId
        from view_company_info
        <where>
            <if test="companyName != null  and companyName != ''"> and COMPANY_NAME=#{companyName}</if>
            <if test="companyId != null  and companyId != ''"> and COMPANY_ID=#{companyId}</if>
        </where>
    </select>

    <select id="getDeptInfo" resultType="java.util.Map">
        select distinct DEPARTMENT deptName,DEPARTMENTID deptId
        from  uum_organizationinfo
        <where>
            <if test="deptName != null  and deptName != ''"> and DEPARTMENT like concat(#{deptName}, '%')</if>
            <if test="companyName != null  and companyName != ''">and COMPANY=#{companyName}</if>
        </where>
