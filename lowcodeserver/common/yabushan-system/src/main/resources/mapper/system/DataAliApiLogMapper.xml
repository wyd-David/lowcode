<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yabushan.system.mapper.DataAliApiLogMapper">
    
    <resultMap type="DataAliApiLog" id="DataAliApiLogResult">
        <result property="logId"    column="log_id"    />
        <result property="keyId"    column="KEY_ID"    />
        <result property="userkey"    column="userkey"    />
        <result property="reqparam"    column="reqParam"    />
        <result property="createdTime"    column="created_time"    />
        <result property="endTime"    column="end_time"    />
        <result property="reqResult"    column="req_result"    />
    </resultMap>

    <sql id="selectDataAliApiLogVo">
        select log_id, KEY_ID, userkey, reqParam, created_time, end_time, req_result from data_ali_api_log
    </sql>

    <select id="selectDataAliApiLogList" parameterType="DataAliApiLog" resultMap="DataAliApiLogResult">
        <include refid="selectDataAliApiLogVo"/>
        <where>  
            <if test="keyId != null  and keyId != ''"> and KEY_ID = #{keyId}</if>
            <if test="userkey != null  and userkey != ''"> and userkey = #{userkey}</if>
            <if test="reqparam != null  and reqparam != ''"> and reqParam = #{reqparam}</if>
            <if test="createdTime != null "> and created_time = #{createdTime}</if>
            <if test="endTime != null "> and end_time = #{endTime}</if>
            <if test="reqResult != null  and reqResult != ''"> and req_result = #{reqResult}</if>
        </where>
    </select>
    
    <select id="selectDataAliApiLogById" parameterType="Long" resultMap="DataAliApiLogResult">
        <include refid="selectDataAliApiLogVo"/>
        where log_id = #{logId}
    </select>
        
    <insert id="insertDataAliApiLog" parameterType="DataAliApiLog" useGeneratedKeys="true" keyProperty="logId">
        insert into data_ali_api_log
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="keyId != null">KEY_ID,</if>
            <if test="userkey != null">userkey,</if>
            <if test="reqparam != null">reqParam,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="endTime != null">end_time,</if>
            <if test="reqResult != null">req_result,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="keyId != null">#{keyId},</if>
            <if test="userkey != null">#{userkey},</if>
            <if test="reqparam != null">#{reqparam},</if>
            <if test="createdTime != null">#{createdTime},</if>
            <if test="endTime != null">#{endTime},</if>
            <if test="reqResult != null">#{reqResult},</if>
         </trim>
    </insert>

    <update id="updateDataAliApiLog" parameterType="DataAliApiLog">
        update data_ali_api_log
        <trim prefix="SET" suffixOverrides=",">
            <if test="keyId != null">KEY_ID = #{keyId},</if>
            <if test="userkey != null">userkey = #{userkey},</if>
            <if test="reqparam != null">reqParam = #{reqparam},</if>
            <if test="createdTime != null">created_time = #{createdTime},</if>
            <if test="endTime != null">end_time = #{endTime},</if>
            <if test="reqResult != null">req_result = #{reqResult},</if>
        </trim>
        where log_id = #{logId}
    </update>

    <delete id="deleteDataAliApiLogById" parameterType="Long">
        delete from data_ali_api_log where log_id = #{logId}
    </delete>

    <delete id="deleteDataAliApiLogByIds" parameterType="String">
        delete from data_ali_api_log where log_id in 
        <foreach item="logId" collection="array" open="(" separator="," close=")">
            #{logId}
        </foreach>
    </delete>
    
</mapper>