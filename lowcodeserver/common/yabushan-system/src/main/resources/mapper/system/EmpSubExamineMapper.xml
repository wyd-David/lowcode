            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
        </trim>
        where REC_ID = #{recId}
    </update>

    <delete id="deleteEmpSubExamineById" parameterType="String">
        delete from emp_sub_examine where REC_ID = #{recId}
    </delete>

    <delete id="deleteEmpSubExamineByIds" parameterType="String">
        delete from emp_sub_examine where REC_ID in 
        <foreach item="recId" collection="array" open="(" separator="," close=")">
            #{recId}
        </foreach>
    </delete>
    
</mapper>