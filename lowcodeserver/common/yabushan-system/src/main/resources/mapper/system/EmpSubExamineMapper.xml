<mapper namespace="com.yabushan.system.mapper.EmpSubExamineMapper">
    
    <resultMap type="EmpSubExamine" id="EmpSubExamineResult">
        <result property="recId"    column="REC_ID"    />
        <result property="empId"    column="EMP_ID"    />
        <result property="startDate"    column="START_DATE"    />
        <result property="endDate"    column="END_DATE"    />
        <result property="sortIndex"    column="SORT_INDEX"    />
        <result property="examineDate"    column="EXAMINE_DATE"    />
        <result property="examineScore"    column="EXAMINE_SCORE"    />
        <result property="examineLevel"    column="EXAMINE_LEVEL"    />
