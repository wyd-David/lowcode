<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yabushan.system.mapper.EmpSubResumeMapper">
    
    <resultMap type="EmpSubResume" id="EmpSubResumeResult">
        <result property="recId"    column="REC_ID"    />
        <result property="empId"    column="EMP_ID"    />
        <result property="sortIndex"    column="SORT_INDEX"    />
        <result property="fromDate"    column="FROM_DATE"    />
        <result property="toDate"    column="TO_DATE"    />
        <result property="belongOrg"    column="BELONG_ORG"    />
        <result property="positionName"    column="POSITION_NAME"    />
        <result property="createBy"    column="CREATE_BY"    />
        <result property="createTime"    column="CREATE_TIME"    />
        <result property="updateBy"    column="UPDATE_BY"    />
        <result property="updateTime"    column="UPDATE_TIME"    />
    </resultMap>

    <sql id="selectEmpSubResumeVo">
        select REC_ID, EMP_ID, SORT_INDEX, FROM_DATE, TO_DATE, BELONG_ORG, POSITION_NAME, CREATE_BY, CREATE_TIME, UPDATE_BY, UPDATE_TIME from emp_sub_resume
    </sql>

    <select id="selectEmpSubResumeList" parameterType="EmpSubResume" resultMap="EmpSubResumeResult">
        <include refid="selectEmpSubResumeVo"/>
        <where>  
            <if test="empId != null  and empId != ''"> and EMP_ID = #{empId}</if>
            <if test="sortIndex != null "> and SORT_INDEX = #{sortIndex}</if>
            <if test="fromDate != null "> and FROM_DATE = #{fromDate}</if>
            <if test="toDate != null "> and TO_DATE = #{toDate}</if>
            <if test="belongOrg != null  and belongOrg != ''"> and BELONG_ORG = #{belongOrg}</if>
            <if test="positionName != null  and positionName != ''"> and POSITION_NAME like concat('%', #{positionName}, '%')</if>
            <if test="createBy != null  and createBy != ''"> and CREATE_BY = #{createBy}</if>
            <if test="createTime != null "> and CREATE_TIME = #{createTime}</if>
            <if test="updateBy != null  and updateBy != ''"> and UPDATE_BY = #{updateBy}</if>
            <if test="updateTime != null "> and UPDATE_TIME = #{updateTime}</if>
        </where>
    </select>
    
    <select id="selectEmpSubResumeById" parameterType="String" resultMap="EmpSubResumeResult">
        <include refid="selectEmpSubResumeVo"/>
        where REC_ID = #{recId}
    </select>
        
    <insert id="insertEmpSubResume" parameterType="EmpSubResume">
        insert into emp_sub_resume
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recId != null">REC_ID,</if>
            <if test="empId != null">EMP_ID,</if>
            <if test="sortIndex != null">SORT_INDEX,</if>
            <if test="fromDate != null">FROM_DATE,</if>
            <if test="toDate != null">TO_DATE,</if>
            <if test="belongOrg != null">BELONG_ORG,</if>
            <if test="positionName != null">POSITION_NAME,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="recId != null">#{recId},</if>
            <if test="empId != null">#{empId},</if>
            <if test="sortIndex != null">#{sortIndex},</if>
            <if test="fromDate != null">#{fromDate},</if>
            <if test="toDate != null">#{toDate},</if>
            <if test="belongOrg != null">#{belongOrg},</if>
            <if test="positionName != null">#{positionName},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateEmpSubResume" parameterType="EmpSubResume">
        update emp_sub_resume
        <trim prefix="SET" suffixOverrides=",">
            <if test="empId != null">EMP_ID = #{empId},</if>
            <if test="sortIndex != null">SORT_INDEX = #{sortIndex},</if>
            <if test="fromDate != null">FROM_DATE = #{fromDate},</if>
            <if test="toDate != null">TO_DATE = #{toDate},</if>
            <if test="belongOrg != null">BELONG_ORG = #{belongOrg},</if>
            <if test="positionName != null">POSITION_NAME = #{positionName},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
        </trim>
        where REC_ID = #{recId}
    </update>

    <delete id="deleteEmpSubResumeById" parameterType="String">
        delete from emp_sub_resume where REC_ID = #{recId}
    </delete>

    <delete id="deleteEmpSubResumeByIds" parameterType="String">
        delete from emp_sub_resume where REC_ID in 
        <foreach item="recId" collection="array" open="(" separator="," close=")">
            #{recId}
        </foreach>
    </delete>
    
</mapper>