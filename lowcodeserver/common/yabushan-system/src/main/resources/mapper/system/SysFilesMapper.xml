<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yabushan.system.mapper.SysFilesMapper">

    <resultMap type="SysFiles" id="SysFilesResult">
        <result property="fileId"    column="file_id"    />
        <result property="fileName"    column="file_name"    />
        <result property="bucket"    column="bucket"    />
        <result property="fileUrl"    column="file_url"    />
        <result property="fileExt"    column="file_ext"    />
        <result property="fileSize"    column="file_size"    />
        <result property="severType"    column="sever_type"    />
        <result property="createdBy"    column="created_by"    />
        <result property="createdTime"    column="created_time"    />
        <result property="updatedBy"    column="updated_by"    />
        <result property="updatedTime"    column="updated_time"    />
        <result property="delFlag"    column="del_flag"    />
    </resultMap>

    <sql id="selectSysFilesVo">
        select file_id, file_name, bucket, file_url, file_ext, file_size, sever_type, created_by, created_time, updated_by, updated_time, del_flag from sys_files
    </sql>

    <select id="selectSysFilesList" parameterType="SysFiles" resultMap="SysFilesResult">
        <include refid="selectSysFilesVo"/>
        <where>
            <if test="fileName != null  and fileName != ''"> and file_name like concat('%', #{fileName}, '%')</if>
            <if test="bucket != null  and bucket != ''"> and bucket = #{bucket}</if>
            <if test="fileUrl != null  and fileUrl != ''"> and file_url = #{fileUrl}</if>
            <if test="fileExt != null  and fileExt != ''"> and file_ext = #{fileExt}</if>
            <if test="fileSize != null "> and file_size = #{fileSize}</if>
            <if test="severType != null  and severType != ''"> and sever_type = #{severType}</if>
            <if test="createdBy != null  and createdBy != ''"> and created_by = #{createdBy}</if>
            <if test="createdTime != null "> and created_time = #{createdTime}</if>
            <if test="updatedBy != null  and updatedBy != ''"> and updated_by = #{updatedBy}</if>
            <if test="updatedTime != null "> and updated_time = #{updatedTime}</if>
        </where>
    </select>

    <select id="selectSysFilesById" parameterType="String" resultMap="SysFilesResult">
        <include refid="selectSysFilesVo"/>
        where file_id = #{fileId}
    </select>

    <insert id="insertSysFiles" parameterType="SysFiles"  keyProperty="fileId">
        insert into sys_files
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="fileId != null and fileId != ''">file_id,</if>
            <if test="fileName != null and fileName != ''">file_name,</if>
            <if test="bucket != null">bucket,</if>
            <if test="fileUrl != null and fileUrl != ''">file_url,</if>
            <if test="fileExt != null">file_ext,</if>
            <if test="fileSize != null">file_size,</if>
            <if test="severType != null and severType != ''">sever_type,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="updatedBy != null">updated_by,</if>
            <if test="updatedTime != null">updated_time,</if>
            <if test="delFlag != null and delFlag != ''">del_flag,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="fileId != null and fileId != ''">#{fileId},</if>
            <if test="fileName != null and fileName != ''">#{fileName},</if>
            <if test="bucket != null">#{bucket},</if>
            <if test="fileUrl != null and fileUrl != ''">#{fileUrl},</if>
            <if test="fileExt != null">#{fileExt},</if>
            <if test="fileSize != null">#{fileSize},</if>
            <if test="severType != null and severType != ''">#{severType},</if>
            <if test="createdBy != null">#{createdBy},</if>
            <if test="createdTime != null">#{createdTime},</if>
            <if test="updatedBy != null">#{updatedBy},</if>
            <if test="updatedTime != null">#{updatedTime},</if>
            <if test="delFlag != null and delFlag != ''">#{delFlag},</if>
        </trim>
    </insert>

    <insert id="bathInsertSysFiles" parameterType="java.util.List">
        insert into sys_files
        <trim prefix="(" suffix=")" suffixOverrides=",">
            file_id,
            file_name,
            bucket,
            file_url,
            file_ext,
            file_size,
            sever_type,
            created_by,
            created_time,
            updated_by,
            updated_time,
            del_flag,
        </trim>
        values
        <foreach collection ="list" item="item" separator =",">
            <trim prefix="(" suffix=")" suffixOverrides=",">
                #{item.fileId},
                #{item.fileName},
                #{item.bucket},
                #{item.fileUrl},
                #{item.fileExt},
                #{item.fileSize},
                #{item.severType},
                #{item.createdBy},
                #{item.createdTime},
                #{item.updatedBy},
                #{item.updatedTime},
                #{item.delFlag},
            </trim>
        </foreach>
    </insert>

    <update id="updateSysFiles" parameterType="SysFiles">
        update sys_files
        <trim prefix="SET" suffixOverrides=",">
            <if test="fileName != null and fileName != ''">file_name = #{fileName},</if>
            <if test="bucket != null">bucket = #{bucket},</if>
            <if test="fileUrl != null and fileUrl != ''">file_url = #{fileUrl},</if>
            <if test="fileExt != null">file_ext = #{fileExt},</if>
            <if test="fileSize != null">file_size = #{fileSize},</if>
            <if test="severType != null and severType != ''">sever_type = #{severType},</if>
            <if test="createdBy != null">created_by = #{createdBy},</if>
            <if test="createdTime != null">created_time = #{createdTime},</if>
            <if test="updatedBy != null">updated_by = #{updatedBy},</if>
            <if test="updatedTime != null">updated_time = #{updatedTime},</if>
            <if test="delFlag != null and delFlag != ''">del_flag = #{delFlag},</if>
        </trim>
        where file_id = #{fileId}
    </update>

    <delete id="deleteSysFilesById" parameterType="String">
        delete from sys_files where file_id = #{fileId}
    </delete>

    <delete id="deleteSysFilesByIds" parameterType="String">
        delete from sys_files where file_id in
        <foreach item="fileId" collection="array" open="(" separator="," close=")">
            #{fileId}
        </foreach>
    </delete>


    <select id="selectSysFileListByIds" parameterType="String" resultMap="SysFilesResult">
        <include refid="selectSysFilesVo"/>
        where file_id in
        <foreach item="fileId" collection="array" open="(" separator="," close=")">
            #{fileId}
        </foreach>
    </select>

</mapper>
