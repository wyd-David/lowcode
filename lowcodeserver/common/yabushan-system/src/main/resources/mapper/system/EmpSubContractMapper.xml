        <result property="contractStatus"    column="CONTRACT_STATUS"    />
        <result property="contractNature"    column="CONTRACT_NATURE"    />
        <result property="createBy"    column="CREATE_BY"    />
        <result property="createTime"    column="CREATE_TIME"    />
        <result property="updateBy"    column="UPDATE_BY"    />
        <result property="updateTime"    column="UPDATE_TIME"    />
        <result property="deadlineTypeName"    column="DEADLINE_TYPE_NAME"    />
        <result property="contractTypeName"    column="CONTRACT_TYPE_NAME"    />
        <result property="continueFlagName"    column="CONTINUE_FLAG_NAME"    />
        <result property="contractStatusName"    column="CONTRACT_STATUS_NAME"    />
        <result property="contractNatureName"    column="CONTRACT_NATURE_NAME"    />
    </resultMap>

    <sql id="selectEmpSubContractVo">
        select REC_ID,
          EMP_ID,
          START_DATE,
          END_DATE,
          SORT_INDEX,
          DEADLINE_TYPE,
          GET_DICT_NAME_BY_TYPE_AND_DATAVALUE('33',DEADLINE_TYPE) AS DEADLINE_TYPE_NAME,
          TERMINATE_DATE,
          TERMINATE_CIRCS,
          CONTRACT_NO,
          CONTRACT_TYPE,
           GET_DICT_NAME_BY_TYPE_AND_DATAVALUE('35',CONTRACT_TYPE) AS CONTRACT_TYPE_NAME,
          CONTINUE_FLAG,
          GET_DICT_NAME_BY_TYPE_AND_DATAVALUE('36',CONTINUE_FLAG) AS CONTINUE_FLAG_NAME,
          TERMINATE_GIST,
          PROBATIONERSHIP_TERM,
          MEMO,
          CONTRACT_POST,
          ASIDE_OFFICE_ADDR,
          CONTRACT_PAY,
          CONTRACT_SIGNED_DATE,
          CONTRACT_STATUS,
          GET_DICT_NAME_BY_TYPE_AND_DATAVALUE('10035',CONTRACT_STATUS) AS CONTRACT_STATUS_NAME,
          CONTRACT_NATURE,
          GET_DICT_NAME_BY_TYPE_AND_DATAVALUE('10036',CONTRACT_NATURE) AS CONTRACT_NATURE_NAME,
          CREATE_BY,
          CREATE_TIME,
          UPDATE_BY,
          UPDATE_TIME
        from emp_sub_contract
    </sql>

    <select id="selectEmpSubContractList" parameterType="EmpSubContract" resultMap="EmpSubContractResult">
        <include refid="selectEmpSubContractVo"/>
        <where>
            <if test="empId != null  and empId != ''"> and EMP_ID = #{empId}</if>
            <if test="startDate != null "> and START_DATE = #{startDate}</if>
            <if test="endDate != null "> and END_DATE = #{endDate}</if>
            <if test="sortIndex != null "> and SORT_INDEX = #{sortIndex}</if>
            <if test="deadlineType != null "> and DEADLINE_TYPE = #{deadlineType}</if>
            <if test="terminateDate != null "> and TERMINATE_DATE = #{terminateDate}</if>
            <if test="terminateCircs != null "> and TERMINATE_CIRCS = #{terminateCircs}</if>
            <if test="contractNo != null  and contractNo != ''"> and CONTRACT_NO = #{contractNo}</if>
            <if test="contractType != null "> and CONTRACT_TYPE = #{contractType}</if>
            <if test="continueFlag != null "> and CONTINUE_FLAG = #{continueFlag}</if>
            <if test="terminateGist != null  and terminateGist != ''"> and TERMINATE_GIST = #{terminateGist}</if>
            <if test="probationershipTerm != null "> and PROBATIONERSHIP_TERM = #{probationershipTerm}</if>
            <if test="memo != null  and memo != ''"> and MEMO = #{memo}</if>
            <if test="contractPost != null  and contractPost != ''"> and CONTRACT_POST = #{contractPost}</if>
            <if test="asideOfficeAddr != null  and asideOfficeAddr != ''"> and ASIDE_OFFICE_ADDR = #{asideOfficeAddr}</if>
            <if test="contractPay != null  and contractPay != ''"> and CONTRACT_PAY = #{contractPay}</if>
            <if test="contractSignedDate != null "> and CONTRACT_SIGNED_DATE = #{contractSignedDate}</if>
            <if test="contractStatus != null "> and CONTRACT_STATUS = #{contractStatus}</if>
            <if test="contractNature != null "> and CONTRACT_NATURE = #{contractNature}</if>
            <if test="createBy != null  and createBy != ''"> and CREATE_BY = #{createBy}</if>
            <if test="createTime != null "> and CREATE_TIME = #{createTime}</if>
            <if test="updateBy != null  and updateBy != ''"> and UPDATE_BY = #{updateBy}</if>
            <if test="updateTime != null "> and UPDATE_TIME = #{updateTime}</if>
        </where>
    </select>

    <select id="selectEmpSubContractById" parameterType="String" resultMap="EmpSubContractResult">
        <include refid="selectEmpSubContractVo"/>
        where REC_ID = #{recId}
    </select>

    <insert id="insertEmpSubContract" parameterType="EmpSubContract">
        insert into emp_sub_contract
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="recId != null">REC_ID,</if>
            <if test="empId != null">EMP_ID,</if>
            <if test="startDate != null">START_DATE,</if>
            <if test="endDate != null">END_DATE,</if>
            <if test="sortIndex != null">SORT_INDEX,</if>
            <if test="deadlineType != null">DEADLINE_TYPE,</if>
            <if test="terminateDate != null">TERMINATE_DATE,</if>
            <if test="terminateCircs != null">TERMINATE_CIRCS,</if>
            <if test="contractNo != null">CONTRACT_NO,</if>
            <if test="contractType != null">CONTRACT_TYPE,</if>
            <if test="continueFlag != null">CONTINUE_FLAG,</if>
            <if test="terminateGist != null">TERMINATE_GIST,</if>
            <if test="probationershipTerm != null">PROBATIONERSHIP_TERM,</if>
            <if test="memo != null">MEMO,</if>
            <if test="contractPost != null">CONTRACT_POST,</if>
            <if test="asideOfficeAddr != null">ASIDE_OFFICE_ADDR,</if>
            <if test="contractPay != null">CONTRACT_PAY,</if>
            <if test="contractSignedDate != null">CONTRACT_SIGNED_DATE,</if>
            <if test="contractStatus != null">CONTRACT_STATUS,</if>
            <if test="contractNature != null">CONTRACT_NATURE,</if>
            <if test="createBy != null">CREATE_BY,</if>
            <if test="createTime != null">CREATE_TIME,</if>
            <if test="updateBy != null">UPDATE_BY,</if>
            <if test="updateTime != null">UPDATE_TIME,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="recId != null">#{recId},</if>
            <if test="empId != null">#{empId},</if>
            <if test="startDate != null">#{startDate},</if>
            <if test="endDate != null">#{endDate},</if>
            <if test="sortIndex != null">#{sortIndex},</if>
            <if test="deadlineType != null">#{deadlineType},</if>
            <if test="terminateDate != null">#{terminateDate},</if>
            <if test="terminateCircs != null">#{terminateCircs},</if>
            <if test="contractNo != null">#{contractNo},</if>
            <if test="contractType != null">#{contractType},</if>
            <if test="continueFlag != null">#{continueFlag},</if>
            <if test="terminateGist != null">#{terminateGist},</if>
            <if test="probationershipTerm != null">#{probationershipTerm},</if>
            <if test="memo != null">#{memo},</if>
            <if test="contractPost != null">#{contractPost},</if>
            <if test="asideOfficeAddr != null">#{asideOfficeAddr},</if>
            <if test="contractPay != null">#{contractPay},</if>
            <if test="contractSignedDate != null">#{contractSignedDate},</if>
            <if test="contractStatus != null">#{contractStatus},</if>
            <if test="contractNature != null">#{contractNature},</if>
            <if test="createBy != null">#{createBy},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="updateBy != null">#{updateBy},</if>
            <if test="updateTime != null">#{updateTime},</if>
         </trim>
    </insert>

    <update id="updateEmpSubContract" parameterType="EmpSubContract">
        update emp_sub_contract
        <trim prefix="SET" suffixOverrides=",">
            <if test="empId != null">EMP_ID = #{empId},</if>
            <if test="startDate != null">START_DATE = #{startDate},</if>
            <if test="endDate != null">END_DATE = #{endDate},</if>
            <if test="sortIndex != null">SORT_INDEX = #{sortIndex},</if>
            <if test="deadlineType != null">DEADLINE_TYPE = #{deadlineType},</if>
            <if test="terminateDate != null">TERMINATE_DATE = #{terminateDate},</if>
            <if test="terminateCircs != null">TERMINATE_CIRCS = #{terminateCircs},</if>
            <if test="contractNo != null">CONTRACT_NO = #{contractNo},</if>
            <if test="contractType != null">CONTRACT_TYPE = #{contractType},</if>
            <if test="continueFlag != null">CONTINUE_FLAG = #{continueFlag},</if>
            <if test="terminateGist != null">TERMINATE_GIST = #{terminateGist},</if>
            <if test="probationershipTerm != null">PROBATIONERSHIP_TERM = #{probationershipTerm},</if>
            <if test="memo != null">MEMO = #{memo},</if>
            <if test="contractPost != null">CONTRACT_POST = #{contractPost},</if>
            <if test="asideOfficeAddr != null">ASIDE_OFFICE_ADDR = #{asideOfficeAddr},</if>
            <if test="contractPay != null">CONTRACT_PAY = #{contractPay},</if>
            <if test="contractSignedDate != null">CONTRACT_SIGNED_DATE = #{contractSignedDate},</if>
            <if test="contractStatus != null">CONTRACT_STATUS = #{contractStatus},</if>
            <if test="contractNature != null">CONTRACT_NATURE = #{contractNature},</if>
            <if test="createBy != null">CREATE_BY = #{createBy},</if>
            <if test="createTime != null">CREATE_TIME = #{createTime},</if>
            <if test="updateBy != null">UPDATE_BY = #{updateBy},</if>
            <if test="updateTime != null">UPDATE_TIME = #{updateTime},</if>
        </trim>
        where REC_ID = #{recId}
    </update>

    <delete id="deleteEmpSubContractById" parameterType="String">
        delete from emp_sub_contract where REC_ID = #{recId}
    </delete>

    <delete id="deleteEmpSubContractByIds" parameterType="String">
        delete from emp_sub_contract where REC_ID in
        <foreach item="recId" collection="array" open="(" separator="," close=")">
            #{recId}
        </foreach>
    </delete>

</mapper>
