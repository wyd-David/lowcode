<mapper namespace="com.yabushan.system.mapper.EmpSubContractMapper">

    <resultMap type="EmpSubContract" id="EmpSubContractResult">
        <result property="recId"    column="REC_ID"    />
        <result property="empId"    column="EMP_ID"    />
        <result property="startDate"    column="START_DATE"    />
        <result property="endDate"    column="END_DATE"    />
        <result property="sortIndex"    column="SORT_INDEX"    />
        <result property="deadlineType"    column="DEADLINE_TYPE"    />
        <result property="terminateDate"    column="TERMINATE_DATE"    />
        <result property="terminateCircs"    column="TERMINATE_CIRCS"    />
        <result property="contractNo"    column="CONTRACT_NO"    />
        <result property="contractType"    column="CONTRACT_TYPE"    />
        <result property="continueFlag"    column="CONTINUE_FLAG"    />
        <result property="terminateGist"    column="TERMINATE_GIST"    />
        <result property="probationershipTerm"    column="PROBATIONERSHIP_TERM"    />
        <result property="memo"    column="MEMO"    />
        <result property="contractPost"    column="CONTRACT_POST"    />
        <result property="asideOfficeAddr"    column="ASIDE_OFFICE_ADDR"    />
        <result property="contractPay"    column="CONTRACT_PAY"    />
