    <select id="getJsEmpInfo" parameterType="com.yabushan.system.domain.vo.OrgRoleUserVo" resultType="com.yabushan.system.domain.vo.RoleEmpInfoVo">
        SELECT sy.`user_name` as loginId,sy.`nick_name` as empName
        FROM sync_user u,sys_user sy,sys_user_role  ur,sys_role r
        WHERE  sy.user_name=u.`LOGINID`
        AND r.`role_id`=ur.`role_id`
        AND sy.`user_id`=ur.`user_id`
        and u.`DPID` in(SELECT g.`DPID` FROM sync_org g WHERE g.`DPCODE` like concat('%', #{orgId}, '%'))
        AND r.`role_name`=#{roleName}
    </select>

    <select id="selectSyncDepAllVo" parameterType="SyncOrg" resultType="com.yabushan.system.domain.vo.SyncOrgVo" >
        SELECT d.*,sd.dep_english_name as depEnglishName,sd.dep_acset as depAcset
        FROM sync_org d,sys_sync_dep sd
        <where>
            d.DPID = sd.sync_dep_id AND sd.is_dept = '1'
            <if test="parentdpid != null and parentdpid != ''">
                and d.PARENTDPID=#{parentdpid}
            </if>
            <if test="dpid != null and dpid != ''">
                and d.DPID=#{dpid}
            </if>
            <if test="dpname != null and dpname != ''">
                and d.DPNAME=#{dpname}
            </if>
            <if test="depEnglishName != null and depEnglishName != ''">
                and ds.dep_english_name=#{depEnglishName}
            </if>
            <if test="depAcset != null and depAcset != ''">
                and ds.dep_acset=#{depAcset}
            </if>
        </where>

    </select>

