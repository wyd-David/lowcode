    <select id="selectSysSyncDepAllParentLevel"  resultMap="SyncOrgResult">
        SELECT d.* FROM sync_org d,sys_sync_dep sd WHERE d.DPID = sd.sync_dep_id AND  d.PARENTDPID='dproot'
    </select>

    <select id="selectSysSyncDepAllSenndLevel" parameterType="SyncOrg" resultMap="SyncOrgResult" >
        SELECT d.*,sd.dep_english_name,sd.dep_acset ,sd.id as syscsdepid,sd.sys_dep_id , sd.sync_dep_id
         FROM sync_org d,sys_sync_dep sd
           <where>
               d.DPID = sd.sync_dep_id AND sd.is_dept = '1'
               <if test="parentdpid != null and parentdpid != ''">
                   and d.PARENTDPID=#{parentdpid}
               </if>
               <if test="dpid != null and dpid != ''">
                   and d.DPID=#{dpid}
               </if>
               <if test="dpname != null and dpname != ''">
                   and d.DPNAME like concat('%', #{dpname}, '%')
               </if>
               <if test="depEnglishName != null and depEnglishName != ''">
                   and sd.dep_english_name like concat('%', #{depEnglishName}, '%')
               </if>
               <if test="depAcset != null and depAcset != ''">
                   and sd.dep_acset=#{depAcset}
               </if>
           </where>

    </select>
    <select id="selectSysSyncDepAll"   resultMap="SyncOrgResult">
        SELECT d.*,sd.dep_english_name,sd.dep_acset ,sd.id as syscsdepid,sd.sys_dep_id , sd.sync_dep_id FROM sync_org d,sys_sync_dep sd WHERE d.DPID = sd.sync_dep_id
        AND d.DPFULLNAME like concat('总部各部门%')
    </select>


    <select id="getLcjsEmpInfo" parameterType="com.yabushan.system.domain.vo.OrgRoleUserVo" resultType="com.yabushan.system.domain.vo.RoleEmpInfoVo">
        SELECT
        S.user_login_id as loginId,
        S.user_name as empName,
        R.role_Name as roleName,
		CONCAT(S.user_name,'(',R.role_name,')') as fullUserName
        FROM
        role_control_manager S,
        role_control R,
        SYS_SYNC_DEP D
        WHERE S.role_control_id = R.role_control_id
        AND R.role_name = #{roleName}
        <if test="orgId != null and orgId != ''">
            AND D.sync_dep_id=#{orgId}
        </if>
        AND D.sys_dep_id=S.scope
    </select>

