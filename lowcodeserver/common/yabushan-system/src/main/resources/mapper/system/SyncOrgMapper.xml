    <update id="updateSyncDeptChildren" parameterType="java.util.List">
        update sync_org set DPCODE =
        <foreach collection="depts" item="item" index="index"
                 separator=" " open="case dept_id" close="end">
            when #{item.dpid} then #{item.dpcode}
        </foreach>
        where dpid in
        <foreach collection="depts" item="item" index="index"
                 separator="," open="(" close=")">
            #{item.dpid}
        </foreach>
    </update>

</mapper>