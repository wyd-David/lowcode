            <if test="serverWay != null">#{serverWay},</if>
            <if test="reqNum != null">#{reqNum},</if>
            <if test="memoInfo != null">#{memoInfo},</if>
            <if test="isGrant != null">#{isGrant},</if>
            <if test="userWay != null">#{userWay},</if>
            <if test="ownerName != null">#{ownerName},</if>
         </trim>
    </insert>

    <update id="updateDataAliApi" parameterType="DataAliApi">
        update data_ali_api
        <trim prefix="SET" suffixOverrides=",">
