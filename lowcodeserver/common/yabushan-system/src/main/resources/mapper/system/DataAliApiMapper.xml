<mapper namespace="com.yabushan.system.mapper.DataAliApiMapper">
    
    <resultMap type="DataAliApi" id="DataAliApiResult">
        <result property="keyId"    column="KEY_ID"    />
        <result property="hostInfo"    column="HOST_INFO"    />
        <result property="methodInfo"    column="METHOD_INFO"    />
        <result property="pathInfo"    column="PATH_INFO"    />
        <result property="appCode"    column="APP_CODE"    />
