    </update>

    <delete id="deleteDataAliApiById" parameterType="String">
        delete from data_ali_api where KEY_ID = #{keyId}
    </delete>

    <delete id="deleteDataAliApiByIds" parameterType="String">
        delete from data_ali_api where KEY_ID in 
        <foreach item="keyId" collection="array" open="(" separator="," close=")">
            #{keyId}
        </foreach>
    </delete>
    
</mapper>