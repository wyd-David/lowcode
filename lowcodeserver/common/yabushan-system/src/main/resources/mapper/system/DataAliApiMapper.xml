    <sql id="selectDataAliApiVo">
        select KEY_ID, HOST_INFO, METHOD_INFO, PATH_INFO, APP_CODE, CONTENT_TYPE, created_by, created_time, API_STATUS, updated_time, updated_by, return_body, LEVEL_NUM, SERVER_WAY, REQ_NUM, MEMO_INFO, IS_GRANT, USER_WAY, OWNER_NAME from data_ali_api
    </sql>

    <select id="selectDataAliApiList" parameterType="DataAliApi" resultMap="DataAliApiResult">
        <include refid="selectDataAliApiVo"/>
        <where>  
            <if test="hostInfo != null  and hostInfo != ''"> and HOST_INFO like concat('%', #{hostInfo}, '%') </if>
            <if test="methodInfo != null  and methodInfo != ''"> and METHOD_INFO = #{methodInfo}</if>
            <if test="pathInfo != null  and pathInfo != ''"> and PATH_INFO = #{pathInfo}</if>
            <if test="appCode != null  and appCode != ''"> and APP_CODE = #{appCode}</if>
            <if test="contentType != null  and contentType != ''"> and CONTENT_TYPE = #{contentType}</if>
            <if test="createdBy != null  and createdBy != ''"> and created_by = #{createdBy}</if>
            <if test="createdTime != null "> and created_time = #{createdTime}</if>
            <if test="apiStatus != null  and apiStatus != ''"> and API_STATUS = #{apiStatus}</if>
            <if test="updatedTime != null "> and updated_time = #{updatedTime}</if>
            <if test="updatedBy != null  and updatedBy != ''"> and updated_by = #{updatedBy}</if>
            <if test="returnBody != null  and returnBody != ''"> and return_body = #{returnBody}</if>
            <if test="levelNum != null "> and LEVEL_NUM = #{levelNum}</if>
            <if test="serverWay != null  and serverWay != ''"> and SERVER_WAY = #{serverWay}</if>
            <if test="reqNum != null "> and REQ_NUM = #{reqNum}</if>
            <if test="memoInfo != null  and memoInfo != ''"> and MEMO_INFO = #{memoInfo}</if>
            <if test="isGrant != null  and isGrant != ''"> and IS_GRANT = #{isGrant}</if>
            <if test="userWay != null  and userWay != ''"> and USER_WAY = #{userWay}</if>
            <if test="ownerName != null  and ownerName != ''"> and OWNER_NAME = #{ownerName}</if>
        </where>
    </select>
    
    <select id="selectDataAliApiById" parameterType="String" resultMap="DataAliApiResult">
        <include refid="selectDataAliApiVo"/>
        where KEY_ID = #{keyId}
    </select>
        
    <insert id="insertDataAliApi" parameterType="DataAliApi">
        insert into data_ali_api
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="keyId != null">KEY_ID,</if>
            <if test="hostInfo != null">HOST_INFO,</if>
            <if test="methodInfo != null">METHOD_INFO,</if>
            <if test="pathInfo != null">PATH_INFO,</if>
            <if test="appCode != null">APP_CODE,</if>
            <if test="contentType != null">CONTENT_TYPE,</if>
            <if test="createdBy != null">created_by,</if>
            <if test="createdTime != null">created_time,</if>
            <if test="apiStatus != null">API_STATUS,</if>
            <if test="updatedTime != null">updated_time,</if>
