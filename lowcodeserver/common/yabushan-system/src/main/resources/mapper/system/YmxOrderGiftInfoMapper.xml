<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yabushan.system.mapper.YmxOrderGiftInfoMapper">
    
    <resultMap type="YmxOrderGiftInfo" id="YmxOrderGiftInfoResult">
        <result property="orderGiftId"    column="ORDER_GIFT_ID"    />
        <result property="orderId"    column="ORDER_ID"    />
        <result property="giftId"    column="GIFT_ID"    />
        <result property="asin"    column="ASIN"    />
        <result property="createdBy"    column="CREATED_BY"    />
        <result property="createdTime"    column="CREATED_TIME"    />
        <result property="lastUpdatedBy"    column="LAST_UPDATED_BY"    />
        <result property="lastUpdatedTime"    column="LAST_UPDATED_TIME"    />
    </resultMap>

    <sql id="selectYmxOrderGiftInfoVo">
        select ORDER_GIFT_ID, ORDER_ID, GIFT_ID, ASIN, CREATED_BY, CREATED_TIME, LAST_UPDATED_BY, LAST_UPDATED_TIME from ymx_order_gift_info
    </sql>

    <select id="selectYmxOrderGiftInfoList" parameterType="YmxOrderGiftInfo" resultMap="YmxOrderGiftInfoResult">
        <include refid="selectYmxOrderGiftInfoVo"/>
        <where>  
            <if test="orderId != null  and orderId != ''"> and ORDER_ID = #{orderId}</if>
            <if test="giftId != null  and giftId != ''"> and GIFT_ID = #{giftId}</if>
            <if test="asin != null  and asin != ''"> and ASIN = #{asin}</if>
            <if test="createdBy != null  and createdBy != ''"> and CREATED_BY = #{createdBy}</if>
            <if test="createdTime != null "> and CREATED_TIME = #{createdTime}</if>
            <if test="lastUpdatedBy != null  and lastUpdatedBy != ''"> and LAST_UPDATED_BY = #{lastUpdatedBy}</if>
            <if test="lastUpdatedTime != null "> and LAST_UPDATED_TIME = #{lastUpdatedTime}</if>
        </where>
    </select>
    
    <select id="selectYmxOrderGiftInfoById" parameterType="String" resultMap="YmxOrderGiftInfoResult">
        <include refid="selectYmxOrderGiftInfoVo"/>
        where ORDER_GIFT_ID = #{orderGiftId}
    </select>
        
    <insert id="insertYmxOrderGiftInfo" parameterType="YmxOrderGiftInfo">
        insert into ymx_order_gift_info
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="orderGiftId != null">ORDER_GIFT_ID,</if>
            <if test="orderId != null and orderId != ''">ORDER_ID,</if>
            <if test="giftId != null">GIFT_ID,</if>
            <if test="asin != null">ASIN,</if>
            <if test="createdBy != null">CREATED_BY,</if>
            <if test="createdTime != null">CREATED_TIME,</if>
            <if test="lastUpdatedBy != null">LAST_UPDATED_BY,</if>
            <if test="lastUpdatedTime != null">LAST_UPDATED_TIME,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="orderGiftId != null">#{orderGiftId},</if>
            <if test="orderId != null and orderId != ''">#{orderId},</if>
            <if test="giftId != null">#{giftId},</if>
            <if test="asin != null">#{asin},</if>
            <if test="createdBy != null">#{createdBy},</if>
            <if test="createdTime != null">#{createdTime},</if>
            <if test="lastUpdatedBy != null">#{lastUpdatedBy},</if>
            <if test="lastUpdatedTime != null">#{lastUpdatedTime},</if>
         </trim>
    </insert>

    <update id="updateYmxOrderGiftInfo" parameterType="YmxOrderGiftInfo">
        update ymx_order_gift_info
        <trim prefix="SET" suffixOverrides=",">
            <if test="orderId != null and orderId != ''">ORDER_ID = #{orderId},</if>
            <if test="giftId != null">GIFT_ID = #{giftId},</if>
            <if test="asin != null">ASIN = #{asin},</if>
            <if test="createdBy != null">CREATED_BY = #{createdBy},</if>
            <if test="createdTime != null">CREATED_TIME = #{createdTime},</if>
            <if test="lastUpdatedBy != null">LAST_UPDATED_BY = #{lastUpdatedBy},</if>
            <if test="lastUpdatedTime != null">LAST_UPDATED_TIME = #{lastUpdatedTime},</if>
        </trim>
        where ORDER_GIFT_ID = #{orderGiftId}
    </update>

    <delete id="deleteYmxOrderGiftInfoById" parameterType="String">
        delete from ymx_order_gift_info where ORDER_GIFT_ID = #{orderGiftId}
    </delete>

    <delete id="deleteYmxOrderGiftInfoByIds" parameterType="String">
        delete from ymx_order_gift_info where ORDER_GIFT_ID in 
        <foreach item="orderGiftId" collection="array" open="(" separator="," close=")">
            #{orderGiftId}
        </foreach>
    </delete>
    
</mapper>